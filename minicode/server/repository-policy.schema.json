{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minicode:repository-policy:1",
  "title": "Minicode repository policy (Agent Format 1.0 profile)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "interface", "execution_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "$ref": "#/$defs/interfaceSchema" },
        "output": { "$ref": "#/$defs/interfaceSchema" }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "config"],
      "properties": {
        "id": { "const": "x-minicode.repository" },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "validation", "environment", "publication"],
          "properties": {
            "scope": { "const": "self_hosted_devbox" },
            "validation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["checks", "additional_checks", "rerun_on", "cleanup", "coverage"],
              "properties": {
                "checks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": { "$ref": "#/$defs/check" }
                },
                "additional_checks": { "enum": ["forbid", "documented_only"] },
                "rerun_on": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "enum": ["proposal", "resubmission"] }
                },
                "cleanup": { "const": "run_owned_only" },
                "coverage": { "const": "documented_scenarios_only" }
              }
            },
            "environment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "isolate"],
              "properties": {
                "mode": { "const": "inherit" },
                "isolate": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["TEMP", "TMP", "build_outputs", "logs"] }
                }
              }
            },
            "publication": {
              "type": "object",
              "additionalProperties": false,
              "required": ["workflow", "provider_checks", "pending", "merge"],
              "properties": {
                "workflow": { "const": "company_pr_inspector" },
                "provider_checks": { "const": "exact_pr_head" },
                "pending": { "const": "wait" },
                "merge": { "const": "human_only" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "interfaceSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "object" } }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|[/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "documentation", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "arguments"],
          "properties": {
            "executable": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
            "arguments": { "type": "array", "items": { "type": "string" } },
            "artifacts_argument": { "type": "string", "pattern": "^--?[a-zA-Z][a-zA-Z0-9-]*$" }
          }
        },
        "documentation": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
        "ports": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["source_commit", "command", "exit_code", "test_counts", "summary", "test_results", "logs", "teardown"] }
        }
      }
    }
  }
}
